# Copy this file to `.env` (same folder as docker-compose.yml) and fill in values.
# Docker Compose automatically picks up values from `.env`.

# OpenWeatherMap API key for the /api/weatherai endpoint.
# Get one free at https://openweathermap.org/api (5 day / 3 hour forecast).
# If left empty, the backend returns a deterministic demo dataset so the UI
# still visualizes weather on first run.
OPENWEATHER_API_KEY=
